{
    "name": "joao-arthur.dev",
    "author": "joao-arthur",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=26.0.0",
            "onFail": "download"
        },
        "packageManager": {
            "name": "pnpm",
            "version": ">=10.0.0",
            "onFail": "download"
        }
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "3.0.10",
        "@sveltejs/kit": "2.70.2",
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "mdsvex": "0.12.8",
        "svelte": "5.56.9",
        "svelte-check": "4.7.6",
        "svelte-preprocess": "6.0.5",
        "typescript": "6.0.3",
        "vite": "8.2.1"
    }
}
